# ---------- backend build ----------
FROM golang:1.25-alpine AS backend
WORKDIR /src
COPY backend/go.mod backend/go.sum ./
RUN go mod download
COPY backend/ ./
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /out/ziggler .

# ---------- frontend build ----------
FROM node:20-alpine AS frontend
WORKDIR /app
RUN npm install -g pnpm
COPY frontend/package.json frontend/pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile
COPY frontend/ ./
ENV NEXT_TELEMETRY_DISABLED=1
RUN pnpm build

# ---------- runtime ----------
FROM node:20-alpine
RUN apk add --no-cache nginx wget

# Backend
COPY --from=backend /out/ziggler /app/ziggler

# Frontend (standalone)
COPY --from=frontend /app/public /app/public
COPY --from=frontend /app/.next/standalone /app
COPY --from=frontend /app/.next/static /app/.next/static

# nginx: serve frontend, proxy API + websocket to backend
COPY <<'NGINX' /etc/nginx/http.d/default.conf
server {
    listen 80;
    server_name _;
    client_max_body_size 10m;

    location /api/v1/ws {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 3600s;
    }
    location /api/ {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    location /_next/static/ {
        proxy_pass http://127.0.0.1:3000;
    }
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
NGINX

COPY <<'ENTRYPOINT' /app/entrypoint.sh
#!/bin/sh
set -e
mkdir -p /data
JWT_SECRET="${JWT_SECRET:?JWT_SECRET must be set}"
export JWT_SECRET DB_DRIVER="${DB_DRIVER:-sqlite}" DB_PATH="${DB_PATH:-/data/ziggler.db}" \
       APP_ENV="${APP_ENV:-production}" GIN_MODE="${GIN_MODE:-release}" PORT=8080

/app/ziggler &
cd /app && PORT=3000 HOSTNAME=0.0.0.0 node server.js &
exec nginx -g 'daemon off;'
ENTRYPOINT
RUN chmod +x /app/entrypoint.sh

EXPOSE 80
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:80/api/v1/health || exit 1

ENTRYPOINT ["/app/entrypoint.sh"]